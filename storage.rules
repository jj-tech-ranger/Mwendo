rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Telemetry storage (owner-scoped, 5MB limit per VT-005)
    match /telemetry/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024;
    }

    // User avatars (2MB limit, image only)
    // Avatars are available only to signed-in users; writes remain owner-scoped.
    match /avatars/{userId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
    }

    // Complaint Evidence (5MB limit, image or video)
    match /evidence/{saccoId}/{complaintId}/{filename} {
      allow read: if request.auth != null && (
        request.auth.token.activeRole == 'admin' ||
        request.auth.token.activeRole == 'authority' ||
        (request.auth.token.activeRole == 'sacco_manager' && request.auth.token.saccoId == saccoId) ||
        (firestore.exists(/databases/(default)/documents/complaints/$(complaintId)) &&
         firestore.get(/databases/(default)/documents/complaints/$(complaintId)).data.reportedByUid == request.auth.uid)
      );
      allow create: if request.auth != null
                   && resource == null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('(image/(jpeg|png|webp|jpg)|video/(mp4|webm|quicktime))')
                   && (
                     request.auth.token.activeRole == 'admin' ||
                     request.auth.token.activeRole == 'authority' ||
                     (firestore.exists(/databases/(default)/documents/complaints/$(complaintId)) &&
                      firestore.get(/databases/(default)/documents/complaints/$(complaintId)).data.reportedByUid == request.auth.uid)
                   );
      allow update, delete: if request.auth != null && (
        request.auth.token.activeRole == 'admin' ||
        request.auth.token.activeRole == 'authority'
      );
    }

    // Black spot evidence: ownership is encoded in the path so Storage rules
    // can enforce it without a cross-service Firestore lookup. The reporter
    // uploads to black_spots/{spotId}/{userId}/{filename}.
    match /black_spots/{spotId}/{userId}/{filename} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                   && resource == null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      allow update, delete: if request.auth != null && (
        request.auth.token.activeRole == 'admin' ||
        request.auth.token.activeRole == 'authority'
      );
    }

    // Legacy black-spot evidence remains readable for signed-in users, but no
    // longer accepts client uploads because the old path cannot prove ownership.
    match /black_spots/{spotId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.activeRole == 'admin' ||
        request.auth.token.activeRole == 'authority'
      );
    }
  }
}
