rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Storage authorization must fail closed for suspended accounts.
    function isSignedIn() {
      return request.auth != null && request.auth.token.get('isSuspended', false) != true;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Telemetry storage (owner-scoped, 5MB limit per VT-005)
    match /telemetry/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn()
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024;
    }

    // User avatars (2MB limit, image only)
    // Avatars are available only to signed-in users; writes remain owner-scoped.
    match /avatars/{userId}/{filename} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
    }

    // Complaint Evidence (5MB limit, image or video)
    match /evidence/{saccoId}/{complaintId}/{filename} {
      allow read: if isSignedIn() && (
        request.auth.token.activeRole == 'admin' ||
        request.auth.token.activeRole == 'authority' ||
        (request.auth.token.activeRole == 'sacco_manager' && request.auth.token.saccoId == saccoId) ||
        (firestore.exists(/databases/(default)/documents/complaints/$(complaintId)) &&
         firestore.get(/databases/(default)/documents/complaints/$(complaintId)).data.reportedByUid == request.auth.uid)
      );
      allow create: if isSignedIn()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('(image/(jpeg|png|webp|jpg)|video/(mp4|webm|quicktime))')
                   && firestore.exists(/databases/(default)/documents/complaints/$(complaintId))
                   && firestore.get(/databases/(default)/documents/complaints/$(complaintId)).data.saccoId == saccoId
                   && (
                     request.auth.token.activeRole == 'admin' ||
                     request.auth.token.activeRole == 'authority' ||
                     firestore.get(/databases/(default)/documents/complaints/$(complaintId)).data.reportedByUid == request.auth.uid
                   );
      allow update, delete: if isSignedIn() && (
        request.auth.token.activeRole == 'admin' ||
        request.auth.token.activeRole == 'authority'
      );
    }

    // Preferred black-spot evidence path: the uploader UID is encoded in the
    // path, but ownership is still proved against the Firestore report.
    match /black_spots/{spotId}/{userId}/{filename} {
      allow read: if isSignedIn() && (
        request.auth.token.activeRole == 'admin' ||
        request.auth.token.activeRole == 'authority' ||
        request.auth.uid == userId
      );
      allow create: if isSignedIn()
                   && request.auth.uid == userId
                   && firestore.exists(/databases/(default)/documents/black_spots/$(spotId))
                   && firestore.get(/databases/(default)/documents/black_spots/$(spotId)).data.reportedByUid == request.auth.uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      allow update, delete: if isSignedIn() && (
        request.auth.token.activeRole == 'admin' ||
        request.auth.token.activeRole == 'authority'
      );
    }

    // Legacy black-spot path: allow a reporter to upload only when the
    // corresponding Firestore black-spot document proves ownership.
    match /black_spots/{spotId}/{filename} {
      allow read: if isSignedIn() && (
        request.auth.token.activeRole == 'admin' ||
        request.auth.token.activeRole == 'authority' ||
        (firestore.exists(/databases/(default)/documents/black_spots/$(spotId)) &&
         firestore.get(/databases/(default)/documents/black_spots/$(spotId)).data.reportedByUid == request.auth.uid)
      );
      allow create: if isSignedIn()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)')
                   && (
                     request.auth.token.activeRole == 'admin' ||
                     request.auth.token.activeRole == 'authority' ||
                     (firestore.exists(/databases/(default)/documents/black_spots/$(spotId)) &&
                      firestore.get(/databases/(default)/documents/black_spots/$(spotId)).data.reportedByUid == request.auth.uid)
                   );
      allow update, delete: if isSignedIn() && (
        request.auth.token.activeRole == 'admin' ||
        request.auth.token.activeRole == 'authority'
      );
    }
  }
}
