# Firebase Web App Configuration (Required for Frontend Client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Optional / Advanced Configurations
# Database ID (Leave empty or set to '(default)' for standard Firestore database)
VITE_FIREBASE_DATABASE_ID=(default)
# reCAPTCHA v3 Enterprise/Standard Site Key for Firebase App Check (Optional in local dev / staging)
VITE_RECAPTCHA_SITE_KEY=
# App Check Debug Token (Development Only: Used to bypass App Check in local developer environments)
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
# Web Push Notifications Public VAPID Key for Firebase Cloud Messaging (Optional)
VITE_FIREBASE_VAPID_KEY=

# Map Configuration (OpenStreetMap / Leaflet custom tile server)
# Optional: Defaults to https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png if left blank
VITE_MAP_TILE_URL=
