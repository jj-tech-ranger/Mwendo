{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "node scripts/generate-icons.js",
    "build": "vite build",
    "preview": "vite preview",
    "check:bundle-security": "node scripts/check-bundle-security.js",
    "clean": "rm -rf dist server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-mwendo-salama-rules \"vitest run --config vitest.rules.config.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "npm run --prefix apps/functions lint",
    "lint:functions": "npm run --prefix apps/functions lint",
    "lint": "tsc --noEmit && eslint .",
    "lint:all": "npm run lint && npm run --prefix apps/functions lint",
    "provision:demo-accounts": "tsx scripts/provision-demo-accounts.ts"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "i18next": "^26.4.0",
    "leaflet": "^1.9.4",
    "localforage": "^1.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.13.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-functions": "^7.3.2",
    "firebase-tools": "^15.28.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
