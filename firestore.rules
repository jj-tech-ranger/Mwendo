rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isNotSuspended() {
      return request.auth.token.get('isSuspended', false) != true;
    }

    function isSignedIn() {
      return request.auth != null && isNotSuspended();
    }

    function isRegisteredUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Authorization reads ONLY request.auth.token.activeRole (the custom claim)
    function getActiveRole() {
      return isSignedIn() && request.auth.token.activeRole != null
        ? request.auth.token.activeRole
        : null;
    }

    function hasActiveRole(role) {
      return getActiveRole() == role;
    }

    function isAdmin() {
      return getActiveRole() == 'admin';
    }

    function isAuthority() {
      return hasActiveRole('authority') || isAdmin();
    }

    function isSaccoManager(saccoId) {
      return isAdmin() || (
        hasActiveRole('sacco_manager') &&
        saccoId != null &&
        request.auth.token.saccoId == saccoId
      );
    }

    function isDriver() {
      return hasActiveRole('driver');
    }

    // VT-003: Kenya geographic bounds (approx lat -4.7 to 5.5, lon 33.5 to 41.9 with generous margin to avoid edge rejections)
    function isWithinKenyaBounds(lat, lon) {
      return (lat is int || lat is float || lat is number) &&
             (lon is int || lon is float || lon is number) &&
             lat >= -5.5 && lat <= 6.0 &&
             lon >= 33.0 && lon <= 43.5;
    }

    // VT-003: Physically plausible speed bounds for matatus/vehicles (0 - 180 km/h)
    function isPlausibleSpeed(speed) {
      return (speed is int || speed is float || speed is number) && speed >= 0 && speed <= 180;
    }

    // VT-003: Temporal plausibility bounds (reject non-timestamp, >5m future timestamps, or >24h past for live events)
    function isPlausibleTimestamp(ts) {
      return ts is timestamp &&
             ts <= request.time + duration.value(5, 'm') &&
             ts >= request.time - duration.value(24, 'h');
    }

    function isValidTripData(data) {
      return ((!('latitude' in data) && !('longitude' in data)) ||
              (('latitude' in data) && ('longitude' in data) && isWithinKenyaBounds(data.latitude, data.longitude))) &&
             (!('startLocation' in data) || data.startLocation == null || (
               ('latitude' in data.startLocation) && ('longitude' in data.startLocation) &&
               isWithinKenyaBounds(data.startLocation.latitude, data.startLocation.longitude)
             )) &&
             (!('endLocation' in data) || data.endLocation == null || (
               ('latitude' in data.endLocation) && ('longitude' in data.endLocation) &&
               isWithinKenyaBounds(data.endLocation.latitude, data.endLocation.longitude)
             )) &&
             (!('lastGpsUpdate' in data) || data.lastGpsUpdate == null || (
               ('latitude' in data.lastGpsUpdate) && ('longitude' in data.lastGpsUpdate) &&
               isWithinKenyaBounds(data.lastGpsUpdate.latitude, data.lastGpsUpdate.longitude) &&
               (!('speedKmH' in data.lastGpsUpdate) || isPlausibleSpeed(data.lastGpsUpdate.speedKmH))
             )) &&
             (!('currentSpeedKmH' in data) || isPlausibleSpeed(data.currentSpeedKmH)) &&
             (!('maxSpeedKmH' in data) || isPlausibleSpeed(data.maxSpeedKmH)) &&
             (!('avgSpeedKmH' in data) || isPlausibleSpeed(data.avgSpeedKmH)) &&
             (!('startTime' in data) || isPlausibleTimestamp(data.startTime)) &&
             (!('timestamp' in data) || isPlausibleTimestamp(data.timestamp));
    }

    function isValidViolationData(data) {
      return ((!('latitude' in data) && !('longitude' in data)) ||
              (('latitude' in data) && ('longitude' in data) && isWithinKenyaBounds(data.latitude, data.longitude))) &&
             (!('recordedSpeedKmH' in data) || isPlausibleSpeed(data.recordedSpeedKmH)) &&
             (!('speedLimitKmH' in data) || isPlausibleSpeed(data.speedLimitKmH)) &&
             (!('timestamp' in data) || isPlausibleTimestamp(data.timestamp));
    }

    // Flat Analytics Wildcard Rule
    match /analytics/{document=**} {
      allow read: if isAdmin() || hasActiveRole('authority') || (
        hasActiveRole('sacco_manager') &&
        resource.data.saccoId == request.auth.token.saccoId
      );
      allow write: if false;
    }

    // Users Collection
    // SECURITY NOTICE (SEC-009): The roles, activeRole, saccoId, authorityId, authorityScope, and badgeNumber fields
    // in the Firestore users document are display/UI-convenience fields ONLY. They must NEVER be treated as an
    // authorization source in Firestore security rules or backend services — the ONLY authorization source
    // for security rules is request.auth.token.activeRole (custom claim).
    // COMPLIANCE NOTICE (SEC-002, SEC-003, SEC-004): termsAccepted, privacyPolicyVersion, termsAcceptedAt,
    // ageConfirmed, and ageConfirmedAt are write-once at registration creation and strictly omitted from
    // client-updatable affectedKeys(), guaranteeing immutable consent audit ledgers.
    match /users/{userId} {
      allow read: if isSignedIn() && (
        isOwner(userId) || isAdmin() || isAuthority() ||
        (hasActiveRole('sacco_manager') && resource.data.saccoId == request.auth.token.saccoId)
      );
      allow create: if isSignedIn() && isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'passenger')
        && request.resource.data.activeRole == 'passenger'
        && request.resource.data.roles == ['passenger']
        && !('saccoId' in request.resource.data)
        && !('authorityId' in request.resource.data)
        && !('authorityScope' in request.resource.data)
        && !('badgeNumber' in request.resource.data)
        && !('isActive' in request.resource.data && request.resource.data.isActive != true);
      allow update: if (
        isAdmin() || (
          isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'phoneNumber',
            'notificationPreferences',
            'theme',
            'language',
            'photoURL',
            'emergencyContacts',
            'updatedAt',
            'analyticsConsent',
            'analyticsConsentAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // Trips Collection
    match /trips/{tripId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.saccoId != null && isSaccoManager(resource.data.saccoId)) ||
        isAdmin() ||
        hasActiveRole('authority')
      );
      allow create: if isRegisteredUser() && request.resource.data.userId == request.auth.uid && isValidTripData(request.resource.data);
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.saccoId != null && isSaccoManager(resource.data.saccoId)) ||
        isAuthority()
      ) && isValidTripData(request.resource.data);
      allow delete: if isAdmin();
    }

    // Vehicles Collection
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn() && (isAdmin() || isAuthority() || isSaccoManager(resource.data.saccoId));
      allow create: if isAuthority() || isAdmin() || isSaccoManager(request.resource.data.saccoId);
      // Disallow client updates modifying riskScore or riskTier (must be computed by server Cloud Functions Gen2)
      allow update: if (isAuthority() || isAdmin() || isSaccoManager(resource.data.saccoId))
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['riskScore', 'riskTier']);
      allow delete: if isAdmin();
    }

    // SACCOs Collection
    match /saccos/{saccoId} {
      allow read: if isSignedIn();
      allow create: if isAuthority() || isAdmin();
      // Disallow client updates modifying safetyScore (must be computed by server Cloud Functions Gen2)
      allow update: if (isAuthority() || isAdmin() || isSaccoManager(saccoId))
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['safetyScore']);
      allow delete: if isAdmin();
    }

    // Authorities Collection
    match /authorities/{authorityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Black Spots Collection
    match /black_spots/{spotId} {
      allow read: if isRegisteredUser();
      allow create: if isRegisteredUser() && request.resource.data.reportedByUid == request.auth.uid;
      allow update: if isAuthority() || isAdmin() || (
        isRegisteredUser() && resource.data.reportedByUid == request.auth.uid
      );
      allow delete: if isAuthority() || isAdmin();
    }

    // Safety Alerts Collection
    match /safety_alerts/{alertId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.saccoId != null && isSaccoManager(resource.data.saccoId)) ||
        isAdmin() ||
        hasActiveRole('authority')
      );
      allow create: if isRegisteredUser() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.saccoId != null && isSaccoManager(resource.data.saccoId)) ||
        isAuthority()
      );
      allow delete: if isAdmin();
    }

    // Violations Collection
    match /violations/{violationId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.saccoId != null && isSaccoManager(resource.data.saccoId)) ||
        isAdmin() ||
        hasActiveRole('authority')
      );
      allow create: if isRegisteredUser() && request.resource.data.userId == request.auth.uid && isValidViolationData(request.resource.data);
      allow update: if ((resource.data.saccoId != null && isSaccoManager(resource.data.saccoId)) || isAuthority() || isAdmin()) && isValidViolationData(request.resource.data);
      allow delete: if isAdmin();
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      allow read: if isSignedIn() && (
        (resource.data.saccoId != null && isSaccoManager(resource.data.saccoId)) ||
        isAuthority() || isAdmin() ||
        resource.data.reportedByUid == request.auth.uid
      );
      allow create: if isRegisteredUser() && request.resource.data.reportedByUid == request.auth.uid;
      allow update: if isAuthority() || isAdmin() || (resource.data.saccoId != null && isSaccoManager(resource.data.saccoId));
      allow delete: if isAdmin();
    }

    // Drivers Collection
    match /drivers/{driverId} {
      allow read: if isSignedIn() && (isAdmin() || isAuthority() || isSaccoManager(resource.data.saccoId));
      allow create: if isAuthority() || isAdmin() || isSaccoManager(request.resource.data.saccoId);
      allow update: if isAuthority() || isAdmin() || isSaccoManager(resource.data.saccoId);
      allow delete: if isAdmin();
    }

    // Inspections Collection
    match /inspections/{inspectionId} {
      allow read: if isSignedIn();
      allow write: if isAuthority();
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if isAuthority() || (hasActiveRole('sacco_manager') && resource.data.saccoId == request.auth.token.saccoId);
      allow create: if (isAuthority() || isAdmin() || hasActiveRole('sacco_manager'))
        && request.resource.data.actorRole == getActiveRole();
      allow update, delete: if false;
    }

    // Team Users Collection
    match /team_users/{teamUserId} {
      allow read: if isSignedIn() && (isAdmin() || isSaccoManager(resource.data.saccoId));
      allow create: if isSaccoManager(request.resource.data.saccoId);
      allow update: if isAdmin() || isSaccoManager(resource.data.saccoId);
      allow delete: if isAdmin() || isSaccoManager(resource.data.saccoId);
    }

    // Processed Events Idempotency Ledger
    match /processedEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Dead Letter Queue for Notification Failures
    match /dlq_notifications/{dlqId} {
      allow read: if isAdmin() || isAuthority();
      allow write: if isAdmin();
    }

    // Public Pins Sync
    match /public_pins/{pinId} {
      allow read: if true;
      allow write: if isAuthority() || isAdmin();
    }

    // Feature Flags
    match /feature_flags/{flagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Config (e.g. system_config/maintenance)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Distributed SACCO Sharded Counters (AN-003) (SEC-003: Tenant-scoped write rules, no isSignedIn catch-all)
    match /saccoCounters/{counterId} {
      allow read: if isAdmin() || isAuthority() || (
        hasActiveRole('sacco_manager') &&
        resource.data.saccoId == request.auth.token.saccoId
      );
      allow create: if (isAdmin() || isAuthority() || (
        hasActiveRole('sacco_manager') &&
        request.resource.data.saccoId == request.auth.token.saccoId
      )) && request.resource.data.keys().hasOnly(['count', 'saccoId', 'metric', 'shardId', 'updatedAt']);
      allow update: if (isAdmin() || isAuthority() || (
        hasActiveRole('sacco_manager') &&
        resource.data.saccoId == request.auth.token.saccoId &&
        request.resource.data.saccoId == request.auth.token.saccoId
      )) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'saccoId', 'metric', 'shardId', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // User Rate Limits (SEC-005)
    match /rate_limits/{userId} {
      allow read, write: if isSignedIn() && (isOwner(userId) || isAdmin());
    }
  }
}
