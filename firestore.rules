rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getActiveRole() {
      return isSignedIn() ? (
        request.auth.token.activeRole != null
          ? request.auth.token.activeRole
          : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeRole
      ) : null;
    }

    function isAdmin() {
      return isSignedIn() && (
        getActiveRole() == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeRole == 'admin'
      );
    }

    function isAuthority() {
      return isSignedIn() && (
        getActiveRole() == 'authority' ||
        isAdmin()
      );
    }

    function isSaccoManager() {
      return isSignedIn() && (
        getActiveRole() == 'sacco_manager' ||
        getActiveRole() == 'sacco_official' ||
        isAdmin()
      );
    }

    function isDriver() {
      return isSignedIn() && getActiveRole() == 'driver';
    }

    // Flat Analytics Wildcard Rule (§7.1)
    match /analytics/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAuthority() || isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Trips Collection
    match /trips/{tripId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isSaccoManager() ||
        isAuthority()
      );
      allow delete: if isAdmin();
    }

    // Vehicles Collection
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create, update: if isSaccoManager() || isAuthority();
      allow delete: if isAdmin();
    }

    // SACCOs Collection
    match /saccos/{saccoId} {
      allow read: if isSignedIn();
      allow create, update: if isSaccoManager() || isAuthority();
      allow delete: if isAdmin();
    }

    // Authorities Collection
    match /authorities/{authorityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Black Spots Collection
    match /black_spots/{spotId} {
      allow read: if true; // Public access for commuters/drivers
      allow create: if isSignedIn();
      allow update: if isAuthority() || isAdmin() || (
        isSignedIn() && resource.data.reportedByUid == request.auth.uid
      );
      allow delete: if isAuthority() || isAdmin();
    }

    // Safety Alerts Collection
    match /safety_alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Violations Collection
    match /violations/{violationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSaccoManager() || isAuthority();
      allow delete: if isAdmin();
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Drivers Collection
    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow write: if isSaccoManager() || isAuthority();
    }

    // Inspections Collection
    match /inspections/{inspectionId} {
      allow read: if isSignedIn();
      allow write: if isAuthority();
    }

    // Telemetry Collection
    match /telemetry/{telemetryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if isSaccoManager() || isAuthority();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Processed Events Idempotency Ledger
    match /processedEvents/{eventId} {
      allow read, write: if isSignedIn();
    }

    // Public Pins Sync
    match /public_pins/{pinId} {
      allow read: if true;
      allow write: if isAuthority() || isAdmin();
    }

    // Feature Flags
    match /feature_flags/{flagId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
