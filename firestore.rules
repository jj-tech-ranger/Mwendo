rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isNotSuspended() {
      return request.auth.token.get('isSuspended', false) != true;
    }

    function isSignedIn() {
      return request.auth != null && isNotSuspended();
    }

    function isRegisteredUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Authorization reads ONLY request.auth.token.activeRole (the custom claim)
    function getActiveRole() {
      return isSignedIn() && request.auth.token.activeRole != null
        ? request.auth.token.activeRole
        : null;
    }

    function hasActiveRole(role) {
      return getActiveRole() == role;
    }

    function isAdmin() {
      return getActiveRole() == 'admin';
    }

    function isAuthority() {
      return hasActiveRole('authority') || isAdmin();
    }

    function isSaccoManager(saccoId) {
      return isAdmin() || (
        hasActiveRole('sacco_manager') &&
        saccoId != null &&
        request.auth.token.saccoId == saccoId
      );
    }

    function isDriver() {
      return hasActiveRole('driver');
    }

    // Flat Analytics Wildcard Rule
    match /analytics/{document=**} {
      allow read: if isAdmin() || hasActiveRole('authority') || (
        hasActiveRole('sacco_manager') &&
        resource.data.saccoId == request.auth.token.saccoId
      );
      allow write: if false;
    }

    // Users Collection
    // SECURITY NOTICE (SEC-009): The roles, activeRole, saccoId, authorityId, authorityScope, and badgeNumber fields
    // in the Firestore users document are display/UI-convenience fields ONLY. They must NEVER be treated as an
    // authorization source in Firestore security rules or backend services — the ONLY authorization source
    // for security rules is request.auth.token.activeRole (custom claim).
    match /users/{userId} {
      allow read: if isSignedIn() && (
        isOwner(userId) || isAdmin() || isAuthority() ||
        (hasActiveRole('sacco_manager') && resource.data.saccoId == request.auth.token.saccoId)
      );
      allow create: if isSignedIn() && isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'passenger')
        && request.resource.data.activeRole == 'passenger'
        && request.resource.data.roles == ['passenger']
        && !('saccoId' in request.resource.data)
        && !('authorityId' in request.resource.data)
        && !('authorityScope' in request.resource.data)
        && !('badgeNumber' in request.resource.data)
        && !('isActive' in request.resource.data && request.resource.data.isActive != true);
      allow update: if (
        isAdmin() || (
          isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'phoneNumber',
            'notificationPreferences',
            'theme',
            'language',
            'photoURL',
            'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // Trips Collection
    match /trips/{tripId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.saccoId != null && isSaccoManager(resource.data.saccoId)) ||
        isAdmin() ||
        hasActiveRole('authority')
      );
      allow create: if isRegisteredUser() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.saccoId != null && isSaccoManager(resource.data.saccoId)) ||
        isAuthority()
      );
      allow delete: if isAdmin();
    }

    // Vehicles Collection
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn() && (isAdmin() || isAuthority() || isSaccoManager(resource.data.saccoId));
      allow create: if isAuthority() || isAdmin() || isSaccoManager(request.resource.data.saccoId);
      // Disallow client updates modifying riskScore or riskTier (must be computed by server Cloud Functions Gen2)
      allow update: if (isAuthority() || isAdmin() || isSaccoManager(resource.data.saccoId))
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['riskScore', 'riskTier']);
      allow delete: if isAdmin();
    }

    // SACCOs Collection
    match /saccos/{saccoId} {
      allow read: if isSignedIn();
      allow create: if isAuthority() || isAdmin();
      // Disallow client updates modifying safetyScore (must be computed by server Cloud Functions Gen2)
      allow update: if (isAuthority() || isAdmin() || isSaccoManager(saccoId))
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['safetyScore']);
      allow delete: if isAdmin();
    }

    // Authorities Collection
    match /authorities/{authorityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Black Spots Collection
    match /black_spots/{spotId} {
      allow read: if isSignedIn();
      allow create: if isRegisteredUser() && request.resource.data.reportedByUid == request.auth.uid;
      allow update: if isAuthority() || isAdmin() || (
        isSignedIn() && resource.data.reportedByUid == request.auth.uid
      );
      allow delete: if isAuthority() || isAdmin();
    }

    // Safety Alerts Collection
    match /safety_alerts/{alertId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.saccoId != null && isSaccoManager(resource.data.saccoId)) ||
        isAdmin() ||
        hasActiveRole('authority')
      );
      allow create: if isRegisteredUser() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.saccoId != null && isSaccoManager(resource.data.saccoId)) ||
        isAuthority()
      );
      allow delete: if isAdmin();
    }

    // Violations Collection
    match /violations/{violationId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.saccoId != null && isSaccoManager(resource.data.saccoId)) ||
        isAdmin() ||
        hasActiveRole('authority')
      );
      allow create: if isRegisteredUser() && request.resource.data.userId == request.auth.uid;
      allow update: if (resource.data.saccoId != null && isSaccoManager(resource.data.saccoId)) || isAuthority();
      allow delete: if isAdmin();
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      allow read: if isSignedIn() && (
        (resource.data.saccoId != null && isSaccoManager(resource.data.saccoId)) ||
        isAuthority() || isAdmin() ||
        resource.data.reportedByUid == request.auth.uid
      );
      allow create: if isRegisteredUser() && request.resource.data.reportedByUid == request.auth.uid;
      allow update: if isAuthority() || isAdmin() || (resource.data.saccoId != null && isSaccoManager(resource.data.saccoId));
      allow delete: if isAdmin();
    }

    // Drivers Collection
    match /drivers/{driverId} {
      allow read: if isSignedIn() && (isAdmin() || isAuthority() || isSaccoManager(resource.data.saccoId));
      allow create: if isAuthority() || isAdmin() || isSaccoManager(request.resource.data.saccoId);
      allow update: if isAuthority() || isAdmin() || isSaccoManager(resource.data.saccoId);
      allow delete: if isAdmin();
    }

    // Inspections Collection
    match /inspections/{inspectionId} {
      allow read: if isSignedIn();
      allow write: if isAuthority();
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if isAuthority() || (hasActiveRole('sacco_manager') && resource.data.saccoId == request.auth.token.saccoId);
      allow create: if (isAuthority() || isAdmin() || hasActiveRole('sacco_manager'))
        && request.resource.data.actorRole == getActiveRole();
      allow update, delete: if false;
    }

    // Team Users Collection
    match /team_users/{teamUserId} {
      allow read: if isSignedIn() && (isAdmin() || isSaccoManager(resource.data.saccoId));
      allow create: if isSaccoManager(request.resource.data.saccoId);
      allow update: if isAdmin() || isSaccoManager(resource.data.saccoId);
      allow delete: if isAdmin() || isSaccoManager(resource.data.saccoId);
    }

    // Processed Events Idempotency Ledger
    match /processedEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Public Pins Sync
    match /public_pins/{pinId} {
      allow read: if true;
      allow write: if isAuthority() || isAdmin();
    }

    // Feature Flags
    match /feature_flags/{flagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Config (e.g. system_config/maintenance)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
